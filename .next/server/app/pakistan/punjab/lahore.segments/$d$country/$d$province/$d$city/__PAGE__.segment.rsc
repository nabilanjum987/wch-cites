text-sm","children":"19:08"}],["$","div",null,{"className":"text-xs text-gray-500 mt-0.5","children":"Maghrib"}]]}],["$","div","Isha",{"className":"bg-[#F5F3EE] rounded-xl p-3 text-center","children":[["$","div",null,{"className":"text-lg","children":"🌑"}],["$","div",null,{"className":"font-mono text-[#01411C] font-semibold text-sm","children":"20:48"}],["$","div",null,{"className":"text-xs text-gray-500 mt-0.5","children":"Isha"}]]}]]}],["$","p",null,{"className":"text-gray-700 leading-relaxed text-sm","children":"Today's prayer times (نماز کے اوقات) in lahore for June 2026: Fajr at 03:18, Dhuhr at 12:03, Asr at 15:42, Maghrib at 19:08, and Isha at 20:48. These timings are calculated using the Karachi method (University of Islamic Sciences), which is the standard reference for prayer times across Pakistan. lahore's latitude and longitude place it in a position where Fajr and Isha times shift noticeably between summer and winter — in June, Fajr begins as early as 3:30 AM, while in December it may be closer to 5:30 AM. Residents of lahore can set browser reminders using the Prayer Times page, which also provides a Qibla compass, monthly timetable PDF download, and Ramadan sehri/iftar schedule. For Hanafi Asr timing — the majority madhab followed in lahore — the shadow length calculation differs from the Shafi'i method; both are provided on the full prayer page."}],["$","a",null,{"href":"/pakistan/punjab/lahore/prayer-times","className":"inline-block mt-3 text-[#01411C] text-sm font-medium hover:underline","children":"Full prayer timetable, Qibla compass & Zakat calculator →"}]]}]
