ge for lahore and Pakistan."}],["$","a",null,{"href":"/pakistan/sports","className":"inline-block mt-3 text-[#01411C] text-sm font-medium hover:underline","children":"Full sports page — live scores, PSL standings, schedules →"}]]}]
