# WorldCityHub — environment variables (set these in Vercel → Project →
# Settings → Environment Variables, then REDEPLOY: NEXT_PUBLIC_ values are
# baked in at build time, so they do nothing until the next build).
#
# IMPORTANT: use these EXACT names. The code reads only these names —
# earlier versions of this file listed different names (METALS_API_KEY,
# EXCHANGERATE_API_KEY, OPENWEATHER_API_KEY) that most of the code never
# reads, which is why keys added under those names had no effect.

# 1) Supabase — data layer + dynamic sitemap cities (most important)
#    Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2) OpenWeather — live weather + air pollution (free key: openweathermap.org)
NEXT_PUBLIC_OPENWEATHER_KEY=
# Same OpenWeather key, server-side name used by src/lib/apis/weather.ts
OPENWEATHER_API_KEY=

# 3) Gold / metals — rates pages (goldapi.io style x-access-token)
NEXT_PUBLIC_METAL_KEY=

# 4) Currency exchange rates (exchangerate-api.com)
NEXT_PUBLIC_EXCHANGE_KEY=

# 5) News — GNews (gnews.io)
NEXT_PUBLIC_GNEWS_KEY=
# Same GNews key, server-side name used by src/lib/apis/sports.ts
GNEWS_API_KEY=

# 6) News page — NewsData.io (optional; without it, news uses mock data)
NEXT_PUBLIC_NEWSDATA_API_KEY=

# 7) Events — Ticketmaster (optional; without it, events use mock data)
NEXT_PUBLIC_TICKETMASTER_KEY=

# No key needed: prayer times (Aladhan API is free/keyless).
